<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Notes\Routes.cs" Link="Linked\Routes.cs" />
    <Compile Include="..\Notes\Models\Note.cs" Link="Linked\Note.cs" />
    <Compile Include="..\Notes\Services\INavigationService.cs" Link="Linked\INavigationService.cs" />
    <Compile Include="..\Notes\Services\INoteStore.cs" Link="Linked\INoteStore.cs" />
    <Compile Include="..\Notes\ViewModels\*.cs" Link="Linked\ViewModels\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>