<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProfileLab.ViewModels"
             x:Class="ProfileLab.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile">
    <!-- One flat Grid in a ScrollView, as in Lab 3. -->
    <ScrollView>
        <Grid Padding="16" RowSpacing="8"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <!-- Row 0: derived state, read only -->
            <Label Text="{Binding DisplayText}"
                   FontSize="28" FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />

            <!-- Rows 1–4: Entry.Text is TwoWay by default; Mode is written out to make it visible -->
            <Label Grid.Row="1" Text="Name" />
            <Entry Grid.Row="2"
                   Text="{Binding Name, Mode=TwoWay}"
                   Placeholder="Your name" ReturnType="Next" />
            <Label Grid.Row="3" Text="Email" />
            <Entry Grid.Row="4"
                   Text="{Binding Email, Mode=TwoWay}"
                   Placeholder="name@example.com" Keyboard="Email" />

            <!-- Row 5: no Clicked handler, no IsEnabled. The command decides. -->
            <Button Grid.Row="5" Text="Save" Margin="0,16,0,0"
                    Command="{Binding SaveCommand}" />

            <!-- Row 6 -->
            <Button Grid.Row="6" Text="Reload saved profile"
                    Command="{Binding LoadCommand}" />

            <!-- Row 7: visible only while SaveCommand runs -->
            <ActivityIndicator Grid.Row="7"
                               IsRunning="{Binding SaveCommand.IsRunning}"
                               IsVisible="{Binding SaveCommand.IsRunning}" />

            <!-- Row 8 -->
            <Label Grid.Row="8" Text="{Binding StatusMessage}" />
        </Grid>
    </ScrollView>
</ContentPage>
