<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdaptiveLab.BenchmarkPage"
             Title="Benchmark">
    <Grid Padding="16" RowSpacing="8" ColumnSpacing="8"
          ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,*">
        <Entry x:Name="RowsEntry" Grid.ColumnSpan="2"
               Text="30" Keyboard="Numeric" Placeholder="Rows per form" />
        <Button Grid.Row="1" Text="Time build" Clicked="OnTimeBuildClicked" />
        <Button Grid.Row="1" Grid.Column="1" Text="Time show" Clicked="OnTimeShowClicked" />
        <Label x:Name="ResultLabel" Grid.Row="2" Grid.ColumnSpan="2" />
        <!-- The form under test is placed here -->
        <ContentView x:Name="Host" Grid.Row="3" Grid.ColumnSpan="2" />
    </Grid>
</ContentPage>
