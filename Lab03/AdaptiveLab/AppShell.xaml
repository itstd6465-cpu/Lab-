<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AdaptiveLab.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AdaptiveLab"
    Shell.FlyoutBehavior="Disabled"
    Title="AdaptiveLab">

    <TabBar>
        <ShellContent Title="Register"
                      ContentTemplate="{DataTemplate local:RegistrationPage}"
                      Route="register" />
        <ShellContent Title="Benchmark"
                      ContentTemplate="{DataTemplate local:BenchmarkPage}"
                      Route="benchmark" />
    </TabBar>

</Shell>
